<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Única cadena de conexión de la solución: solo la capa de negocios accede a la base de datos. -->
  <connectionStrings>
    <add name="BDUsuarios"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=GrupoDigitalBank;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>

  <!-- La raíz del sitio muestra la página del servicio en lugar de un error de listado de directorio. -->
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="UsuarioService.svc" />
      </files>
    </defaultDocument>
  </system.webServer>

  <system.serviceModel>
    <services>
      <!-- Endpoint: dirección (la del .svc), binding (SOAP sobre HTTP) y contrato. -->
      <service name="GDB.Usuarios.Servicio.UsuarioService">
        <endpoint address="" binding="basicHttpBinding" contract="GDB.Usuarios.Contratos.IUsuarioService" />
      </service>
    </services>
    <behaviors>
      <serviceBehaviors>
        <behavior>
          <!-- Publica el WSDL en ?wsdl y oculta al cliente los detalles internos de los errores. -->
          <serviceMetadata httpGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="false" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <!-- WCF no activa el servicio si hay menos de 5 % de RAM libre; en desarrollo se desactiva ese umbral. -->
    <serviceHostingEnvironment minFreeMemoryPercentageToActivateService="0" />
  </system.serviceModel>

</configuration>
