<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <appSettings>
    <!-- Validadores con el script clásico de ASP.NET, sin depender de jQuery. -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <globalization culture="es-CO" uiCulture="es-CO" fileEncoding="utf-8" />
  </system.web>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="UsuarioConsulta.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>

  <!-- Lo único que la web sabe del backend: dirección, binding y contrato del servicio. Sin cadena de conexión. -->
  <system.serviceModel>
    <client>
      <endpoint name="UsuarioService"
                address="http://localhost:5100/UsuarioService.svc"
                binding="basicHttpBinding"
                contract="GDB.Usuarios.Contratos.IUsuarioService" />
    </client>
  </system.serviceModel>

</configuration>
