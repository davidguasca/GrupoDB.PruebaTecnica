    <title></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&family=Open+Sans:wght@400;600&family=Questrial&display=swap" rel="stylesheet" />
    <link href="Content/site.css" rel="stylesheet" />
    <script src="Scripts/sitio.js" defer></script>
</head>
<body>
    <header class="encabezado">
        <div class="contenedor">
            <a href="UsuarioConsulta.aspx" class="marca">Grupo <span>Digital Bank</span></a>
